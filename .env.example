# Copy to .env (gitignored) for docker compose. Never commit real values.
# OpenAI-compatible model server (vLLM, Ollama, LiteLLM, or an API provider)
DATA_AGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
DATA_AGENT_LLM_API_KEY=EMPTY
DATA_AGENT_LLM_MODEL=llama3.2
# Embeddings for catalog search (Ollama nomic-embed-text); `fake` or `off` to disable
DATA_AGENT_EMBED_BASE_URL=http://host.docker.internal:11434/v1
DATA_AGENT_EMBEDDINGS=auto
# Keyed hash for customer tokens. Must match the secret the replicas were built with.
DATA_AGENT_PII_SECRET=change-me
# Bearer tokens (sha256 hashes -> user, role); create with: data-agent token --user alice --role analyst
# (writes data/state/tokens.json, which compose mounts as a secret; prints the token once)
DATA_AGENT_TOKENS_FILE=/run/secrets/tokens.json
# MCP over HTTP: public URL of the endpoint and the authorisation server that issues tokens
DATA_AGENT_MCP_PUBLIC_URL=http://localhost:8765/mcp
DATA_AGENT_MCP_ISSUER_URL=https://auth.example.com
DATA_AGENT_MCP_ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765
